	struct AVFrame;
	struct AVPacket;
}

/**
* @namespace StormByte::Multimedia::Pipeline::Filter
* @brief Facades, chain and reports for pipeline filter plugins.
*/
namespace StormByte::Multimedia::Pipeline::Filter {
	/**
	* @class FFmpeg
	* @brief Abstract base for every StormByte Multimedia filter.
	*
	* Do not inherit this type directly. Inherit @ref Process,
	* @ref Packet or @ref Analytics. Construct with a short name
	* (`resize`). @ref Name is `Media()/name`.
	*
	* @par Lifecycle
	* The constructor only stores the name. @ref Reset (called by
	* @ref Chain on the first unit of a run) clears Fail flags,
	* then @ref Clean, then @ref Setup. @ref Flush runs during the
	* run and once after @ref Eof. The destructor must not Flush.
	* Plugins must be restartable. Everything is noexcept; errors
	* go through @ref Fail. No exceptions.
	*
	* @par Dispatch
	* @ref Chain calls @ref Call. Call checks @ref Media and
	* forwards to @ref Process. Facades also gate by @ref Origin.
	* A leaf implements one Process overload; the others stay
	* the empty FFmpeg default.
	*
	* @par Native
	* @ref Native / @ref Replace talk to libav of FFmpeg
	* @STORMBYTE_FFMPEG_VERSION@. Do not free the pointer
	* @ref Native returns. Do not link libav next to Multimedia.
	*/
	class STORMBYTE_MULTIMEDIA_PUBLIC FFmpeg {
		public:
			/**
			* @name Lifetime
			* @{
			*/

			/**
			* @brief Copy constructor (deleted).
			*/
			FFmpeg(const FFmpeg&) = delete;

			/**
			* @brief Move constructor.
			* @param other Filter to take.
			*/
			FFmpeg(FFmpeg&& other) noexcept = default;

			/**
			* @brief Destructor.
			*/
			virtual ~FFmpeg() noexcept;

			/**
			* @brief Copy assignment (deleted).
			* @return *this.
			*/
			FFmpeg& operator=(const FFmpeg&) = delete;

			/**
			* @brief Move assignment.
			* @param other Filter to take.
			* @return *this.
			*/
			FFmpeg& operator=(FFmpeg&& other) noexcept = default;

			/** @} */

			/**
			* @name Identity
			* @{
			*/

			/**
			* @brief Media this filter handles.
			* @return Video, Audio or Subtitle.
			*/
			virtual enum Type Media() const noexcept = 0;

			/**
			* @brief `Media()/name` computed on each call.
			* @return Identity string.
			*/
			std::string Name() const noexcept;

			/** @} */

			/**
			* @name Run
			* @{
			*/

			/**
			* @brief Clears Fail, then @ref Clean, then @ref Setup.
			*/
			void Reset() noexcept;

			/**
			* @brief Entry from @ref Chain for a frame.
			* @param frame Unit in the pipe.
			* @param origin Stage that is calling.
			*/
			virtual void Call(Pipeline::Frame& frame, Origin origin) noexcept;

			/**
			* @brief Entry from @ref Chain for a packet.
			* @param packet Unit in the pipe.
			* @param origin Stage that is calling.
			*/
			virtual void Call(class Pipeline::Packet& packet, Origin origin) noexcept;

			/**
			* @brief End of @p origin. Default no-op.
			* @param origin Stage that ended.
			*/
			virtual void Eof(Origin origin) noexcept;

			/**
			* @brief Periodic / final drain. Default no-op.
			* @param origin Stage that is draining.
			*/
			virtual void Flush(Origin origin) noexcept;

			/**
			* @brief Measurement, if any.
			* @return None and an empty map by default.
			*/
			virtual class Report Report() const noexcept;

			/** @} */

			/**
			* @name Status
			* @{
			*/

			/**
			* @brief Whether @ref Fail was called since the last @ref Reset.
			* @return true after a hard error.
			*/
			bool Failed() const noexcept;

			/**
			* @brief `Plugin Name() failed: reason`.
			* @return Formatted text.
			*
			* @pre @ref Failed is true. Debug asserts; release returns empty.
			*/
			std::string ErrorStr() const noexcept;

			/** @} */

		protected:
			/**
			* @brief Named plugin. There is no empty constructor.
			* @param name Short leaf name (`resize`).
			*/
			explicit FFmpeg(std::string name) noexcept;

			/**
			* @brief Drops per-run state. First-run no-op is allowed.
			*/
			virtual void Clean() noexcept = 0;

			/**
			* @brief Acquires per-run state. Must be callable again after @ref Clean.
			*/
			virtual void Setup() noexcept = 0;

			/**
			* @brief Frame body. Pure on @ref FFmpeg so a leaf of @ref Process / @ref Analytics implements it.
			* @param frame Unit in the pipe.
			* @param origin Stage that is calling.
			*/
			virtual void Process(Pipeline::Frame& frame, Origin origin) noexcept = 0;

			/**
			* @brief Packet body. Empty default so @ref Process / @ref Analytics are not forced to name this method.
			* @param packet Unit in the pipe.
			* @param origin Stage that is calling.
			*/
			virtual void Process(class Pipeline::Packet& packet, Origin origin) noexcept;

			/**
			* @brief Marks a hard error. The job must stop.
			* @param reason Bare message; @ref ErrorStr prepends the plugin name.
			*/
			void Fail(std::string reason) noexcept;

			/**
			* @brief Borrowed libav frame owned by @p frame, or nullptr.
			* @param frame Owner of the backend buffer.
			* @return ::AVFrame from FFmpeg @STORMBYTE_FFMPEG_VERSION@.
			*/
			static ::AVFrame* Native(Pipeline::Frame& frame) noexcept;

			/**
			* @brief Borrowed libav frame owned by @p frame, or nullptr.
			* @param frame Owner of the backend buffer.
			* @return ::AVFrame from FFmpeg @STORMBYTE_FFMPEG_VERSION@.
			*/
			static const ::AVFrame* Native(const Pipeline::Frame& frame) noexcept;

			/**
			* @brief Borrowed libav packet owned by @p packet, or nullptr.
			* @param packet Owner of the backend buffer.
			* @return ::AVPacket from FFmpeg @STORMBYTE_FFMPEG_VERSION@.
			*/
			static ::AVPacket* Native(class Pipeline::Packet& packet) noexcept;

			/**
			* @brief Borrowed libav packet owned by @p packet, or nullptr.
			* @param packet Owner of the backend buffer.
			* @return ::AVPacket from FFmpeg @STORMBYTE_FFMPEG_VERSION@.
			*/
			static const ::AVPacket* Native(const class Pipeline::Packet& packet) noexcept;

			/**
			* @brief Replaces the backend of @p frame with @p raw (takes ownership).
			* @param frame Pipeline frame.
			* @param raw libav frame allocated by the plugin.
			*/
			static void Replace(Pipeline::Frame& frame, ::AVFrame* raw) noexcept;

			/**
			* @brief Replaces the backend of @p packet with @p raw (takes ownership).
			* @param packet Pipeline packet.
			* @param raw libav packet allocated by the plugin.
			*/
			static void Replace(class Pipeline::Packet& packet, ::AVPacket* raw) noexcept;

		private:
			std::string m_name;				///< Leaf name
			bool m_failed = false;			///< Hard error
			std::string m_reason;			///< Bare Fail text
	};

	/**
	* @class Process
	* @brief Mutates decoded frames on @ref Origin::Decoder.
	*
	* Do not declare a method named Process on this class: that is
	* a constructor. The leaf (`Resize`) implements
	* @ref FFmpeg::Process (Frame). Packet Process stays the empty
	* FFmpeg default.
	*/
	class STORMBYTE_MULTIMEDIA_PUBLIC Process: public FFmpeg {
		public:
			/**
			* @brief Copy constructor (deleted).
			*/
			Process(const Process&) = delete;

			/**
			* @brief Move constructor.
			* @param other Filter to take.
			*/
			Process(Process&& other) noexcept = default;

			/**
			* @brief Destructor.
			*/
			~Process() noexcept override = default;

			/**
			* @brief Copy assignment (deleted).
			* @return *this.
			*/
			Process& operator=(const Process&) = delete;

			/**
			* @brief Move assignment.
			* @param other Filter to take.
			* @return *this.
			*/
			Process& operator=(Process&& other) noexcept = default;

			/**
			* @brief Decoder frames only.
			* @param frame Unit in the pipe.
			* @param origin Stage that is calling.
			*/
			void Call(Pipeline::Frame& frame, Origin origin) noexcept override;

			/**
			* @brief Packets are ignored.
			* @param packet Unused.
			* @param origin Unused.
			*/
			void Call(class Pipeline::Packet& packet, Origin origin) noexcept override;

		protected:
			/**
			* @brief Named process node.
			* @param name Short leaf name (`resize`).
			*/
			explicit Process(std::string name) noexcept;
	};

	/**
	* @class Packet
	* @brief Mutates compressed packets on @ref Origin::Demux / @ref Origin::Mux.
	*/
	class STORMBYTE_MULTIMEDIA_PUBLIC Packet: public FFmpeg {
		public:
			/**
			* @brief Copy constructor (deleted).
			*/
			Packet(const Packet&) = delete;

			/**
			* @brief Move constructor.
			* @param other Filter to take.
			*/
			Packet(Packet&& other) noexcept = default;

			/**
			* @brief Destructor.
			*/
			~Packet() noexcept override = default;

			/**
			* @brief Copy assignment (deleted).
			* @return *this.
			*/
			Packet& operator=(const Packet&) = delete;

			/**
			* @brief Move assignment.
			* @param other Filter to take.
			* @return *this.
			*/
			Packet& operator=(Packet&& other) noexcept = default;

			/**
			* @brief Frames are ignored.
			* @param frame Unused.
			* @param origin Unused.
			*/
			void Call(Pipeline::Frame& frame, Origin origin) noexcept override;

			/**
			* @brief Demux / mux packets.
			* @param packet Unit in the pipe.
			* @param origin Stage that is calling.
			*/
			void Call(class Pipeline::Packet& packet, Origin origin) noexcept override;

			/**
			* @brief Packet leaves do not implement the frame body.
			* @param frame Unused.
			* @param origin Unused.
			*/
			void Process(Pipeline::Frame& frame, Origin origin) noexcept final;

		protected:
			/**
			* @brief Named packet node.
			* @param name Short leaf name.
			*/
			explicit Packet(std::string name) noexcept;
	};

	/**
	* @class Analytics
	* @brief Measures frames on @ref Origin::Decoder and @ref Origin::Encoder.
	*/
	class STORMBYTE_MULTIMEDIA_PUBLIC Analytics: public FFmpeg {
		public:
			/**
			* @brief Copy constructor (deleted).
			*/
			Analytics(const Analytics&) = delete;

			/**
			* @brief Move constructor.
			* @param other Filter to take.
			*/
			Analytics(Analytics&& other) noexcept = default;

			/**
			* @brief Destructor.
			*/
			~Analytics() noexcept override = default;

			/**
			* @brief Copy assignment (deleted).
			* @return *this.
			*/
			Analytics& operator=(const Analytics&) = delete;

			/**
			* @brief Move assignment.
			* @param other Filter to take.
			* @return *this.
			*/
			Analytics& operator=(Analytics&& other) noexcept = default;

			/**
			* @brief Decoder / encoder frames.
			* @param frame Unit in the pipe.
			* @param origin Stage that is calling.
			*/
			void Call(Pipeline::Frame& frame, Origin origin) noexcept override;

			/**
			* @brief Packets are ignored.
			* @param packet Unused.
			* @param origin Unused.
			*/
			void Call(class Pipeline::Packet& packet, Origin origin) noexcept override;

		protected:
			/**
			* @brief Named analytics node.
			* @param name Short leaf name (`vmaf`).
			*/
			explicit Analytics(std::string name) noexcept;
	};
}
