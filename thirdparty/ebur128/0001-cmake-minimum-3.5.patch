From 5d522b92d281c0ccdb5a43dcc0c47c91f168a14d Mon Sep 17 00:00:00 2001
From: "David C. Manuelda" <StormByte@gmail.com>
Date: Sat, 19 Sep 2026 12:46:07 +0200
Subject: [PATCH] cmake: require 3.5 so CMake 4 will configure

cmake_minimum_required(2.8.12) is rejected by CMake >= 4.0.
---
 CMakeLists.txt      | 2 +-
 test/CMakeLists.txt | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index ff8baea..4e1b9bf 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -1,4 +1,4 @@
-cmake_minimum_required(VERSION 2.8.12 FATAL_ERROR)
+cmake_minimum_required(VERSION 3.5 FATAL_ERROR)
 project(libebur128 C)
 
 option(BUILD_SHARED_LIBS
diff --git a/test/CMakeLists.txt b/test/CMakeLists.txt
index 6ffbf17..5853dd8 100644
--- a/test/CMakeLists.txt
+++ b/test/CMakeLists.txt
@@ -1,4 +1,4 @@
-cmake_minimum_required(VERSION 2.8.12)
+cmake_minimum_required(VERSION 3.5 FATAL_ERROR)
 
 set(ENABLE_TESTS OFF CACHE BOOL "Build test binaries, needs libsndfile")
 set(ENABLE_FUZZER OFF CACHE BOOL "Build fuzzer binary")
-- 
2.55.0

