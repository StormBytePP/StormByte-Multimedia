From 2172bacc51531e9c5995e9501275336dad4e448c Mon Sep 17 00:00:00 2001
From: "David C. Manuelda" <StormByte@gmail.com>
Date: Sun, 29 Mar 2026 13:17:15 +0200
Subject: [PATCH 05/18] MSVC: Add Windows pthreads support (bundled + external)

- Integrate GerHobbelt/pthread-win32 as bundled implementation
- Add -Dbundled_winpthreads option (default: true)
- Support detecting external pthreads libraries (pthreadVC3, etc.)

Signed-off-by: David C. Manuelda <StormByte@gmail.com>
---
 .gitmodules                       |  3 ++
 libvmaf/meson.build               | 62 +++++++++++++++++++++++++++++++
 libvmaf/meson_options.txt         |  5 +++
 libvmaf/src/meson.build           |  7 ++--
 libvmaf/subprojects/pthread-win32 |  1 +
 libvmaf/test/meson.build          | 17 +++++----
 libvmaf/tools/meson.build         |  2 +-
 7 files changed, 86 insertions(+), 11 deletions(-)
 create mode 100644 .gitmodules
 create mode 160000 libvmaf/subprojects/pthread-win32

diff --git a/.gitmodules b/.gitmodules
new file mode 100644
index 0000000000..758af93407
--- /dev/null
+++ b/.gitmodules
@@ -0,0 +1,3 @@
+[submodule "GerHobbelt-pthread-win32"]
+	path = libvmaf/subprojects/pthread-win32
+	url = https://github.com/GerHobbelt/pthread-win32
diff --git a/libvmaf/meson.build b/libvmaf/meson.build
index ede16ad80b..ea0ed2c744 100644
--- a/libvmaf/meson.build
+++ b/libvmaf/meson.build
@@ -63,6 +63,68 @@ else
     )
 endif
 
+pthreadwin32_inc = []
+pthreadwin32_lib = []
+thread_lib = []
+
+if cc.get_id() == 'msvc'
+    if get_option('bundled_winpthreads')
+        cmake = import('cmake')
+        pthreadwin32_opts = cmake.subproject_options()
+        pthreadwin32_opts.add_cmake_defines({
+            'BUILD_SHARED_LIBS': false,
+        })
+        pthreadwin32_proj = cmake.subproject('pthread-win32', options: pthreadwin32_opts)
+        # static_lib() → libpthreadVC3; shared → pthreadVC3
+        if pthreadwin32_proj.dependency('libpthreadVC3').found()
+            pthreadwin32_lib = pthreadwin32_proj.dependency('libpthreadVC3')
+        else
+            pthreadwin32_lib = pthreadwin32_proj.dependency('pthreadVC3')
+        endif
+        pthreadwin32_inc = include_directories('./subprojects/pthread-win32')
+    else
+        external_pthread = dependency('pthread', required: false)
+        if not external_pthread.found()
+            foreach name : [
+                'libpthreadVC3', 'libpthreadVC2', 'libpthreadVC',
+                'pthreadVC3', 'pthreadVC2', 'pthreadVC',
+                'libpthreadVCE3', 'pthreadVCE3',
+                'libpthreadVSE3', 'pthreadVSE3',
+                'pthread', 'libpthread', 'pthreads'
+            ]
+                external_pthread = cc.find_library(name, required: false)
+                if external_pthread.found()
+                    break
+                endif
+            endforeach
+        endif
+        if not external_pthread.found()
+            error('MSVC build requested with -Dbundled_winpthreads=false, ' +
+                  'but no external pthreads library was found.\n' +
+                  'Please install a Windows pthreads implementation and make sure ' +
+                  'the library is discoverable, or use the bundled one (default).')
+        endif
+        if not cc.check_header('pthread.h', required: false)
+            error('External pthreads library was found, but <pthread.h> could not be located.\n' +
+                  'Please make sure the include directory is available (e.g. via INCLUDE ' +
+                  'environment variable or -I flags).')
+        endif
+        pthreadwin32_lib = external_pthread
+    endif
+
+    # Match pthreads4w static VC build (__PTW32_CLEANUP_C + __PTW32_STATIC_LIB)
+    thread_lib = declare_dependency(
+        dependencies: [pthreadwin32_lib],
+        include_directories: pthreadwin32_inc,
+        compile_args: [
+            '-D__PTW32_CLEANUP_C',
+            '-D__PTW32_STATIC_LIB',
+        ],
+    )
+else
+    thread_lib = dependency('threads')
+endif
+
 subdir('include')
 subdir('src')
 subdir('tools')
