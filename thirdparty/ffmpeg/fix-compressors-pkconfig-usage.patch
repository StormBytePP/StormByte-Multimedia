From 52fb9871c0695b05728a665325c625dd815937d1 Mon Sep 17 00:00:00 2001
From: "David C. Manuelda" <StormByte@gmail.com>
Date: Sun, 23 Aug 2026 19:14:08 +0200
Subject: [PATCH] meson: detect lzma and bzlib via pkg-config like zlib

Probe lzma and bzlib through pkg-config (liblzma / bzip2) instead of
find_library component checks, matching the existing zlib path.

This applies Cflags from the installed .pc files during feature tests.
On MSVC with static liblzma, that includes LZMA_API_STATIC and avoids
unresolved __imp_lzma_* symbols when the option is enabled.

Remove the redundant component entries so each compressor has a single
detection path.

Also fix the "requested but not found" error to format the library name
into the message (format was applied to error()'s return value).

Signed-off-by: David C. Manuelda <StormByte@gmail.com>
---
 meson.build | 6 +++---
 1 file changed, 3 insertions(+), 3 deletions(-)

diff --git a/meson.build b/meson.build
index 0c78c8710e..39795f5d4b 100644
--- a/meson.build
+++ b/meson.build
@@ -1006,6 +1006,8 @@ check_pkg_config = [
   ['vulkan_static', ['vulkan/vulkan.h'], ['vkGetInstanceProcAddr'], {'pkg': 'vulkan', 'version': '>= 1.3.277'}],
   ['whisper', ['whisper.h'], ['whisper_init_from_file_with_params'], {'pkg': 'vulkan', 'version': '>= 1.7.5'}],
   ['zlib', ['zlib.h'], ['zlibVersion'], {'pkg': 'zlib'}],
+  ['lzma', ['lzma.h'], ['lzma_version_number'], {'pkg': 'liblzma'}],
+  ['bzlib', ['bzlib.h'], ['BZ2_bzlibVersion'], {'pkg': 'bzip2'}],
 ]
 
 if get_option('xlib').allowed()
@@ -1085,7 +1087,6 @@ check_components = [
   ['alsa', ['alsa/asoundlib.h'], ['snd_pcm_htimestamp'], ['asound']],
   ['android', ['android/native_window.h'], ['ANativeWindow_acquire'], ['android']],
   ['bcrypt', ['windows.h', 'bcrypt.h'], ['BCryptGenRandom'], ['bcrypt'],{'defines': ['BCRYPT_RNG_ALGORITHM']}],
-  ['bzlib', ['bzlib.h'], ['BZ2_bzlibVersion'], ['bz2']],
   ['camera2ndk', ['stdbool.h', 'stdint.h', 'camera/NdkCameraManager.h'], ['ACameraManager_create'], ['camera2ndk']],
   ['decklink', ['DeckLinkAPI.h'], [], []],
   ['libcelt', ['celt/celt.h'], ['celt_decoder_create_custom'], ['celt0']],
@@ -1135,7 +1136,6 @@ check_components = [
     {'defines': ['VPX_IMG_FMT_HIGHBITDEPTH'], 'extra_deps': ['libm_extra_deps', 'thread_dep']}],
   ['libxvid', ['xvid.h'], ['xvid_global'], ['xvidcore']],
   ['linux_fb_h', ['linux/fb.h'], [], []],
-  ['lzma', ['lzma.h'], ['lzma_version_number'], ['lzma']],
   ['mbedtls', ['mbedtls/ssl.h'], ['mbedtls_ssl_init'], ['mbedtls', 'mbedx509', 'mbedcrypto']],
   ['mediandk', ['stdint.h', 'media/NdkMediaFormat.h'], ['AMediaFormat_new'], ['mediandk']],
   ['mmal', ['interface/mmal/mmal.h'], ['mmal_port_connect'], ['mmal_core', 'mmal_util', 'mmal_vc_client', 'bcm_host']],
@@ -3444,7 +3444,7 @@ endif
 
 foreach lib: autodetect_libs
   if conf_requested.get(lib, 0) == 1 and conf.get(lib, 0) == 0
-    error('@0@ requested but not found').format(lib)
+    error('@0@ requested but not found'.format(lib))
   endif
 endforeach
 
