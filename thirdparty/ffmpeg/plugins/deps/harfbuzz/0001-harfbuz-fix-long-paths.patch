+with open(OUTPUT, "wb") as f:
+	f.write("".join(
+		'#include "{}"\n'.format(
+			pathlib.Path(os.path.relpath(os.path.abspath(x), CURRENT_SOURCE_DIR)).as_posix()
+		)
+		for x in sources if x.endswith(".cc")
