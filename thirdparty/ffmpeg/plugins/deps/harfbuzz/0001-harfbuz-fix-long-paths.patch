@@ -10,15 +10,31 @@ if len (sys.argv) < 3:
 OUTPUT = sys.argv[1]
 CURRENT_SOURCE_DIR = sys.argv[2]
 
+def _load_sources(argv_rest):
+	# Single listfile argument (plain path or @path) keeps the Ninja/CreateProcess
+	# command line short on Windows (error 87).
+	if len(argv_rest) == 1:
+		listfile = argv_rest[0]
+		if listfile.startswith("@"):
+			listfile = listfile[1:]
+		with open(listfile, encoding="utf-8") as fh:
+			return [ln.strip() for ln in fh if ln.strip()]
+	return list(argv_rest)
+
 # make sure input files are unique
-sources = sorted(set(sys.argv[3:]))
+sources = sorted(set(_load_sources(sys.argv[3:])))
 
