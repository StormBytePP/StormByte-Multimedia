[submodule "StormByte base"]
	path = thirdparty/StormByte/base/src
	url = https://github.com/StormBytePP/StormByte.git
	branch = master
[submodule "Opus codec"]
	path = thirdparty/ffmpeg/plugins/codecs/audio/opus/src
	url = https://gitlab.xiph.org/xiph/opus.git
[submodule "FDK-AAC codec"]
	path = thirdparty/ffmpeg/plugins/codecs/audio/fdk-aac/src
	url = https://github.com/mstorsjo/fdk-aac.git
[submodule "Ogg container"]
	path = thirdparty/ffmpeg/plugins/containers/ogg/src
	url = https://gitlab.xiph.org/xiph/ogg.git
[submodule "Vorbis codec"]
	path = thirdparty/ffmpeg/plugins/codecs/audio/vorbis/src
	url = https://gitlab.xiph.org/xiph/vorbis.git
[submodule "FFmpeg"]
	path = thirdparty/ffmpeg/src
	url = https://gitlab.freedesktop.org/gstreamer/meson-ports/ffmpeg.git
	branch = meson-8.1
[submodule "VPX codec"]
	path = thirdparty/ffmpeg/plugins/codecs/video/vpx/src
